{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, HEAD, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "*" },
        { "key": "Access-Control-Max-Age", "value": "86400" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/tilezen/vector/v1/all/:path*",
      "destination": "/api/topojson?nextzen=:path*"
    },
    {
      "source": "/tiles/:path*",
      "has": [
        {
          "type": "host",
          "value": "stadiamaps.allapi.cc"
        }
      ],
      "destination": "/api/stadiamaps"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "thunderforest.allapi.cc"
        }
      ],
      "destination": "/api/thunderforest"
    }
  ]
}